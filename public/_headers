# Production response headers.
# The script hash is the inline theme script in index.html; tests/headers.test.js keeps them in sync.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://plausible.io 'sha256-H0iLqDFrJJrMQPrGYmY6rKdJhrOtZUrS0TaMlF5NamM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://plausible.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
